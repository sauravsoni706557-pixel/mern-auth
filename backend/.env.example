# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://admin:admin2007@cluster0.7crpm5t.mongodb.net/?appName=Cluster0
# Secrets used to sign tokens 
ACCESS_TOKEN_SECRET=change_this_to_a_long_random_string
REFRESH_TOKEN_SECRET=change_this_to_a_different_long_random_string

# Token expiry times
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Set to "production" when deploying (enables secure cookies)
NODE_ENV=development
